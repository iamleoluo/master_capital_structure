<title>MSTR 資本結構解剖</title>
<style>
:root{
  --paper:#F4F6F4; --surface:#FFFFFF; --surface-2:#EDF0EE;
  --ink:#151C20; --ink-2:#4A585F; --ink-3:#7C8A91;
  --line:#DCE2E0; --line-2:#C6CFCC;
  --c1:#062F3D; --c2:#0D4A5B; --c3:#186C7C; --c4:#3C919F; --c5:#77B6BF; --c6:#B4D5D8;
  --equity:#BC7126; --equity-soft:#F0E0CC;
  --senti:#A6435A; --senti-soft:#F2DDE1;
  --btc:#2C383E;
  --good:#2F6E4F; --warn:#B07A12; --bad:#A6435A;
  --serif:"Iowan Old Style",Georgia,"Songti TC","Noto Serif CJK TC",serif;
  --sans:system-ui,-apple-system,"PingFang TC","Microsoft JhengHei",sans-serif;
  --mono:ui-monospace,"SF Mono",Menlo,"Cascadia Mono",Consolas,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --paper:#0E1418; --surface:#151D22; --surface-2:#1B252B;
  --ink:#E9EAE5; --ink-2:#9DADB4; --ink-3:#6A7981;
  --line:#232F35; --line-2:#31414A;
  --c1:#0B4356; --c2:#125C71; --c3:#1E7D90; --c4:#43A0AE; --c5:#7FC2CB; --c6:#B0DCE1;
  --equity:#DE9A4F; --equity-soft:#3A2C18;
  --senti:#D67C90; --senti-soft:#3A222A;
  --btc:#C3CDD2;
  --good:#5AA37C; --warn:#D6A63C; --bad:#D67C90;
}}
:root[data-theme="dark"]{
  --paper:#0E1418; --surface:#151D22; --surface-2:#1B252B;
  --ink:#E9EAE5; --ink-2:#9DADB4; --ink-3:#6A7981;
  --line:#232F35; --line-2:#31414A;
  --c1:#0B4356; --c2:#125C71; --c3:#1E7D90; --c4:#43A0AE; --c5:#7FC2CB; --c6:#B0DCE1;
  --equity:#DE9A4F; --equity-soft:#3A2C18;
  --senti:#D67C90; --senti-soft:#3A222A;
  --btc:#C3CDD2;
  --good:#5AA37C; --warn:#D6A63C; --bad:#D67C90;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--sans);font-size:16px;line-height:1.72;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
.narrow{max-width:660px}
h1,h2,h3{font-family:var(--serif);font-weight:600;text-wrap:balance;line-height:1.25;margin:0}
h2{font-size:clamp(1.5rem,3.1vw,2.05rem);letter-spacing:-.012em}
h3{font-size:1.14rem;letter-spacing:-.005em}
p{margin:0 0 1.05em}
a{color:var(--equity)}
.num{font-family:var(--mono);font-variant-numeric:tabular-nums}
.eyebrow{font-family:var(--mono);font-size:.7rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--ink-3);margin:0 0 .55em}

/* ---------- rails / sections ---------- */
section{padding:76px 0;border-top:1px solid var(--line)}
section:first-of-type{border-top:none}
.sec-head{display:flex;gap:20px;align-items:baseline;margin-bottom:34px}
.sec-num{font-family:var(--mono);font-size:.78rem;color:var(--ink-3);
  padding-top:.5em;flex:0 0 auto;letter-spacing:.06em}
.lede{font-size:1.06rem;color:var(--ink-2);max-width:64ch;margin-top:.7em}

/* ---------- hero ---------- */
.hero{padding:96px 0 72px;border:none}
.hero h1{font-size:clamp(2.3rem,6.2vw,3.9rem);letter-spacing:-.028em;margin-bottom:.28em}
.hero .sub{font-size:1.12rem;color:var(--ink-2);max-width:60ch}
.stamp{font-family:var(--mono);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;
  color:var(--ink-3);display:flex;gap:14px;flex-wrap:wrap;margin-bottom:2.4em}
.stamp b{color:var(--ink-2);font-weight:500}

/* ---------- the identity ---------- */
.identity{background:var(--surface);border:1px solid var(--line);border-radius:3px;
  padding:34px 30px;margin:38px 0 8px;overflow-x:auto}
.eq{display:flex;align-items:stretch;gap:0;min-width:640px}
.eq-term{flex:1 1 0;padding:2px 16px;border-left:1px solid var(--line);position:relative}
.eq-term:first-child{border-left:none;padding-left:0}
.eq-op{flex:0 0 auto;display:flex;align-items:center;padding:0 4px;
  font-family:var(--mono);color:var(--ink-3);font-size:1.05rem}
.eq-lab{font-size:.76rem;color:var(--ink-3);letter-spacing:.04em;margin-bottom:.4em;
  display:flex;align-items:center;gap:6px}
.eq-val{font-family:var(--mono);font-size:1.42rem;font-variant-numeric:tabular-nums;
  letter-spacing:-.02em;line-height:1.2}
.eq-sub{font-size:.74rem;color:var(--ink-3);margin-top:.3em;line-height:1.45}
.swatch{width:9px;height:9px;border-radius:2px;flex:0 0 auto}
.eq-term.result .eq-val{color:var(--equity);font-size:1.62rem}
.eq-cap{font-size:.82rem;color:var(--ink-3);margin-top:20px;padding-top:16px;
  border-top:1px dashed var(--line-2)}

/* ---------- generic blocks ---------- */
.card{background:var(--surface);border:1px solid var(--line);border-radius:3px;padding:24px 26px}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:16px}
figure{margin:0}
figcaption{font-size:.83rem;color:var(--ink-3);margin-top:14px;line-height:1.6;max-width:76ch}
svg{max-width:100%;height:auto;display:block}
.scroller{overflow-x:auto;-webkit-overflow-scrolling:touch}

/* ---------- callouts ---------- */
.note{border-left:2px solid var(--line-2);padding:2px 0 2px 18px;color:var(--ink-2);
  font-size:.94rem;margin:26px 0}
.note.key{border-left-color:var(--equity)}
.note.warn{border-left-color:var(--warn)}
.note b{color:var(--ink)}

/* ---------- stat tiles ---------- */
.tile{background:var(--surface);border:1px solid var(--line);border-radius:3px;padding:17px 18px}
.tile .k{font-size:.75rem;color:var(--ink-3);letter-spacing:.03em;margin-bottom:.42em}
.tile .v{font-family:var(--mono);font-size:1.44rem;font-variant-numeric:tabular-nums;
  letter-spacing:-.02em;line-height:1.15}
.tile .d{font-size:.76rem;color:var(--ink-3);margin-top:.42em;line-height:1.5}

/* ---------- tables ---------- */
table{border-collapse:collapse;width:100%;font-size:.9rem}
th{text-align:left;font-weight:500;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;
  color:var(--ink-3);padding:0 12px 9px;border-bottom:1px solid var(--line-2);white-space:nowrap}
td{padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top}
td.n,th.n{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums}
tr:last-child td{border-bottom:none}
.mini td,.mini th{padding:7px 10px;font-size:.85rem}

/* ---------- controls ---------- */
.ctl{display:flex;flex-direction:column;gap:7px}
.ctl-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.ctl-lab{font-size:.82rem;color:var(--ink-2)}
.ctl-val{font-family:var(--mono);font-size:1.02rem;font-variant-numeric:tabular-nums;color:var(--ink)}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:20px;
  background:transparent;cursor:pointer;margin:0}
input[type=range]::-webkit-slider-runnable-track{height:3px;background:var(--line-2);border-radius:2px}
input[type=range]::-moz-range-track{height:3px;background:var(--line-2);border-radius:2px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:15px;height:15px;
  border-radius:50%;background:var(--equity);margin-top:-6px;border:2px solid var(--surface)}
input[type=range]::-moz-range-thumb{width:15px;height:15px;border-radius:50%;
  background:var(--equity);border:2px solid var(--surface)}
input[type=range]:focus-visible{outline:2px solid var(--equity);outline-offset:3px}
.seg{display:inline-flex;border:1px solid var(--line-2);border-radius:3px;overflow:hidden}
.seg button{font-family:var(--sans);font-size:.8rem;padding:6px 13px;border:none;
  background:var(--surface);color:var(--ink-2);cursor:pointer;border-left:1px solid var(--line-2)}
.seg button:first-child{border-left:none}
.seg button[aria-pressed=true]{background:var(--ink);color:var(--paper)}
.seg button:focus-visible{outline:2px solid var(--equity);outline-offset:-2px}

/* ---------- legend ---------- */
.legend{display:flex;flex-wrap:wrap;gap:7px 18px;font-size:.79rem;color:var(--ink-2);margin-top:12px}
.legend span{display:inline-flex;align-items:center;gap:6px}

footer{border-top:1px solid var(--line);padding:44px 0 68px;font-size:.83rem;color:var(--ink-3)}
@media (max-width:640px){
  .eq{min-width:560px}
  section{padding:56px 0}
  .sec-head{flex-direction:column;gap:4px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
