<script>
// ---------- §05 reverse calculator ----------
const CALC_FIXED = (function(){
  const fwp = DATA.fwp;
  const otherPref = Object.entries(fwp.pref).filter(([k])=>k!=='STRC')
                     .reduce((s,[,v])=>s+v,0);
  return { held: fwp.held, debt: fwp.debt, otherPref, shares: fwp.basic/1e9*1e9,
           sharesM: fwp.basic };
})();
let calcBasis = 'cebe';

function calcCompute(btc, strc, mnavTarget){
  const held = CALC_FIXED.held;
  const nav = held*btc; // USD
  const claims = (CALC_FIXED.debt + CALC_FIXED.otherPref + strc)*1e9;
  const shares = CALC_FIXED.sharesM;
  let perShare, cp;
  if(calcBasis==='cebe'){
    perShare = (nav - claims)/shares;
    cp = claims/nav;
  } else {
    perShare = nav/shares;
    cp = 0;
  }
  const price = mnavTarget*perShare;
  const beBtc = claims/held;
  const amp = calcBasis==='cebe' ? nav/(nav-claims) : 1;
  return {price, perShare, cp, beBtc, amp, nav, claims};
}

function paintCalc(){
  const btc = +$('s-btc').value;
  const strc = +$('s-strc').value;
  const mnavTarget = +$('s-mnav').value;
  $('v-btc').textContent = fmt$0(btc);
  $('v-strc').textContent = '$'+strc.toFixed(2)+'B';
  $('v-mnav').textContent = mnavTarget.toFixed(2)+'x';

  const r = calcCompute(btc, strc, mnavTarget);
  $('calc-price').textContent = r.price>0 ? fmt$(r.price) : '$0.00';
  $('calc-sub').textContent = calcBasis==='cebe'
    ? `扣求償權後每股殘值 × 目標 mNAV`
    : `BTC 總市值 ÷ basic 股數 × 目標 mNAV(不扣求償權)`;
  $('calc-ps').textContent = r.perShare>0? fmt$(r.perShare) : '$0.00';
  $('calc-cp').textContent = fmtPct(r.cp);
  $('calc-amp').textContent = calcBasis==='cebe' ? fmtX(r.amp) : '—';
  $('calc-be').textContent = calcBasis==='cebe' ? fmt$0(r.beBtc) : '不適用';

  drawCurve(strc, mnavTarget);
}

function drawCurve(strc, mnavTarget){
  const W=920,H=260,padL=64,padR=20,padT=18,padB=36;
  const plotW=W-padL-padR, plotH=H-padT-padB;
  const btcMin=15000, btcMax=200000;
  const pts=[]; const NPT=140;
  for(let i=0;i<=NPT;i++){
    const btc = btcMin + (btcMax-btcMin)*i/NPT;
    const r = calcCompute(btc, strc, mnavTarget);
    pts.push([btc, Math.max(0,r.price)]);
  }
  const maxP = Math.max(...pts.map(p=>p[1]))*1.12 || 100;
  const x = b => padL + plotW*(b-btcMin)/(btcMax-btcMin);
  const y = p => padT + plotH*(1-p/maxP);

  let svg=[];
  for(let g=0;g<=4;g++){
    const val = maxP*g/4, gy=y(val);
    svg.push(`<line x1="${padL}" y1="${gy}" x2="${W-padR}" y2="${gy}" stroke="currentColor" stroke-opacity=".08"/>`);
    svg.push(`<text x="${padL-8}" y="${gy+4}" font-size="10" text-anchor="end" fill="currentColor" opacity=".55" font-family="var(--mono)">$${val.toFixed(0)}</text>`);
  }
  [30000,60000,100000,150000].forEach(b=>{
    if(b<btcMin||b>btcMax) return;
    svg.push(`<line x1="${x(b)}" y1="${padT}" x2="${x(b)}" y2="${H-padB}" stroke="currentColor" stroke-opacity=".06"/>`);
    svg.push(`<text x="${x(b)}" y="${H-padB+16}" font-size="10" text-anchor="middle" fill="currentColor" opacity=".55" font-family="var(--mono)">$${(b/1000)}K</text>`);
  });

  const path = pts.map((p,i)=>(i===0?'M':'L')+x(p[0]).toFixed(1)+','+y(p[1]).toFixed(1)).join(' ');
  svg.push(`<path d="${path}" fill="none" stroke="var(--equity)" stroke-width="2.4"/>`);

  // current point
  const curBtc = +$('s-btc').value;
  const curR = calcCompute(curBtc, strc, mnavTarget);
  svg.push(`<circle cx="${x(curBtc)}" cy="${y(Math.max(0,curR.price))}" r="4.5" fill="var(--equity)" stroke="var(--surface)" stroke-width="2"/>`);

  // break-even marker
  if(calcBasis==='cebe'){
    const be = curR.beBtc;
    if(be>=btcMin && be<=btcMax){
      svg.push(`<line x1="${x(be)}" y1="${padT}" x2="${x(be)}" y2="${H-padB}" stroke="var(--bad)" stroke-dasharray="2,3" stroke-width="1.2"/>`);
      svg.push(`<text x="${x(be)}" y="${padT+12}" font-size="10" fill="var(--bad)" text-anchor="middle">歸零 $${Math.round(be/1000)}K</text>`);
    }
  }

  svg.push(`<line x1="${padL}" y1="${H-padB}" x2="${W-padR}" y2="${H-padB}" stroke="currentColor" stroke-opacity=".25"/>`);
  svg.push(`<text x="${(padL+W-padR)/2}" y="${H-2}" font-size="10.5" text-anchor="middle" fill="currentColor" opacity=".6">BTC 價格</text>`);

  $('curve-chart').innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="在目前設定下,MSTR 隱含股價隨 BTC 價格變化的曲線,標出歸零點與目前位置">${svg.join('')}</svg>`;
}

['s-btc','s-strc','s-mnav'].forEach(id=>$(id).addEventListener('input', paintCalc));
document.querySelectorAll('#basis-seg button').forEach(b=>{
  b.addEventListener('click', ()=>{
    calcBasis = b.dataset.b;
    document.querySelectorAll('#basis-seg button').forEach(x=>x.setAttribute('aria-pressed', x===b));
    paintCalc();
  });
});
paintCalc();

// ---------- §06 sensitivity + break-even ----------
(function(){
  $('sens-tbl').innerHTML = DATA.sens.map(s=>{
    const err = (s.got-s.off)/s.off*1e4;
    return `<tr><td class="num">$${s.btc.toLocaleString('en-US')}</td>
      <td class="n">$${s.off.toFixed(2)}</td><td class="n">$${s.got.toFixed(4)}</td>
      <td class="n" style="color:var(--ink-3)">${err>=0?'+':''}${err.toFixed(2)}bp</td></tr>`;
  }).join('');

  const beLab = {company_net_reserve:'官方(扣 USD Reserve)', cebetracker:'cebetracker(扣現金)',
                 mnav_com:'mnav.com(毛額,漏 STRE)', company:'毛額含 STRE(不扣現金)'};
  const curBtc = DATA.fwp.btc;
  $('be-tbl').innerHTML = DATA.be.map(b=>{
    const buf = curBtc/b.v;
    return `<tr><td>${beLab[b.k]}</td><td class="n">$${b.v.toLocaleString('en-US')}</td>
      <td class="n">${buf.toFixed(2)}x</td></tr>`;
  }).join('');
})();

// ---------- §07 findings ----------
(function(){
  $('findings').innerHTML = DATA.findings.map(f=>`
    <div class="card">
      <h3 style="font-size:1rem;margin-bottom:8px">${f.t}</h3>
      <p style="font-size:.88rem;color:var(--ink-2);margin:0">${f.b}</p>
    </div>`).join('');
})();
</script>
